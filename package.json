{
  "name": "sehari",
  "private": true,
  "version": "0.1.0",
  "description": "Sehari — kapsul waktu harian yang diisi bersama orang terdekat.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @sehari/server",
    "dev:mobile": "npm run start -w @sehari/mobile",
    "web": "npm run web -w @sehari/mobile",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e": "node e2e/flow.mjs",
    "seed": "npx tsx apps/server/scripts/seed.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright-core": "1.56.1"
  }
}
