# Salin ke .env (atau setel di platform hosting). Semua opsional untuk pengembangan.
PORT=8787
PUBLIC_URL=https://api.sehari.app
APP_URL=https://sehari.app
# Postgres produksi. Kosong = PGlite di DATA_DIR.
DATABASE_URL=
DATA_DIR=./data/pglite
SERVER_SECRET=ganti-dengan-rahasia-acak-panjang
ADMIN_TOKEN=
# Email kode masuk (Resend). Kosong = dicetak ke konsol.
RESEND_API_KEY=
EMAIL_FROM="Sehari <halo@sehari.app>"
# Pembayaran web (Xendit Invoice: QRIS, e-wallet, VA). Kosong = pembayaran tiruan.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# Penyimpanan media terenkripsi (S3-compatible). Kosong = disk lokal.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-southeast-3
# Push via Expo
EXPO_ACCESS_TOKEN=
# AI cloud opt-in (judul bab). Kosong = fitur nonaktif.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Produksi: matikan kode dev di respons
DEV_AUTH=0
NODE_ENV=production
